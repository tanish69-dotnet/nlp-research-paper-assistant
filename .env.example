# ============================================================================
# ResearchLens — Reasoning Service configuration
# Copy to .env and edit. NEVER commit .env.
# All keys are read by app/config.py (pydantic-settings).
# ============================================================================

# --- Runtime -----------------------------------------------------------------
REASONING_ENV=local                 # local | test | prod
API_HOST=127.0.0.1                  # keep localhost unless behind a proxy
API_PORT=8000
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | console
ENABLE_EVAL_API=false               # POST /api/v1/evaluate
CORS_ORIGINS=http://localhost:5173  # comma-separated; no * in prod

# --- Model provider ----------------------------------------------------------
MODEL_PROVIDER=ollama               # ollama | openai_compat | mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_COMPAT_BASE_URL=             # vLLM / LM Studio / cloud gateway (optional)
OPENAI_COMPAT_API_KEY=              # optional; env-only, never logged

# Role -> model mapping (change models without touching agent code)
ANALYZER_MODEL=llama3.1:8b
TEXT_MODEL=llama3.1:8b
TABLE_MODEL=llama3.1:8b
VISION_MODEL=llama3.2-vision
JUDGE_MODEL=llama3.1:8b
GENERATOR_MODEL=llama3.1:8b

MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=2048

# --- Timeouts / retries / concurrency ---------------------------------------
REQUEST_TIMEOUT_MS=120000          # whole-request budget
AGENT_TIMEOUT_MS=60000             # per-agent budget
PROVIDER_TIMEOUT_MS=45000          # per model call
MODEL_MAX_RETRIES=2
PROVIDER_MAX_CONCURRENCY=2         # semaphore per provider (protects local Ollama)

# --- Retrieval (Person 2 service, Phase 8 /ask) ------------------------------
RETRIEVAL_MODE=disabled             # disabled | mock | http
RETRIEVAL_BASE_URL=http://localhost:8000
RETRIEVAL_TIMEOUT_SECONDS=30
RETRIEVAL_TOP_K=5
# Note: reasoning API defaults to API_PORT=8001 when Person 2 occupies 8000.
# To read Person 2's extracted figure images on one machine, EVIDENCE_ROOT
# must cover the image directory. For the local demo that is
#   multimodal_rag_retrieval_person2/data
# so set EVIDENCE_ROOT=multimodal_rag_retrieval_person2/data in your .env.
# Long term, pass figure bytes (image.b64) instead of a filesystem path
# shared between repos — or mount a single shared directory.

# --- Evidence path confinement (EVIDENCE_ROOT bounds all figure reads) ------
EVIDENCE_ROOT=./evidence           # images must resolve inside this directory
MAX_EVIDENCE_ITEMS=40
MAX_EVIDENCE_CHARS=120000
MAX_EVIDENCE_ITEM_CHARS=8000
MAX_IMAGE_BYTES=10485760           # 10 MiB
MAX_IMAGE_PIXELS=20000000
MAX_REQUEST_BYTES=4194304          # 4 MiB
MAX_CONTEXT_TOKENS=7000            # evidence budget per model call

# --- Pipeline behavior -------------------------------------------------------
INCLUDE_AGENT_OUTPUTS=true
CONFIDENCE_THRESHOLD=0.5
JUDGE_ENABLED=true
